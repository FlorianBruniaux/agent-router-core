{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-router:schema:version:1",
  "title": "version",
  "description": "Output of `agent-router version --json`: the build and the contract schema versions this binary supports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "target",
    "features",
    "contracts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/contract"
      }
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "schema_versions"
      ],
      "properties": {
        "command": {
          "type": "string"
        },
        "schema_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "integer",
              "string"
            ]
          }
        }
      }
    }
  }
}
